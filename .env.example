# ─────────────────────────────────────────────────────────────────────────────
# EduPlus AI — environment contract
#
# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude (Anthropic) ───────────────────────────────────────────────────────
# Powers: Report Agent, Faculty Copilot, CSV header mapping, voice message
# drafting. Claude NEVER computes the risk score — that is the deterministic
# engine in packages/core/risk.
ANTHROPIC_API_KEY=sk-ant-...
# Current Claude Sonnet model id (verified against docs.claude.com).
# Read ONLY from this var — never hard-code a model name anywhere else.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Firebase client (safe to expose to the browser) ──────────────────────────
# These are public identifiers, not secrets: access is controlled by Firestore
# security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-only — NEVER expose to any client) ───────────────
# From a service-account JSON: Firebase console → Project settings →
# Service accounts → Generate new private key.
# Keep the private key on ONE line with literal \n escapes, wrapped in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Point the Admin SDK at the local emulator instead of live Firestore.
# Leave unset/empty to use the real project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Sarvam AI (Indian-language speech) ──────────────────────────────────────
# TTS : POST https://api.sarvam.ai/text-to-speech   (model bulbul:v4-flash)
# STT : POST https://api.sarvam.ai/speech-to-text   (model saaras:v4)
# Auth header is `api-subscription-key`, NOT a Bearer token.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_STT_MODEL=saaras:v4

# ── Vobiz (telephony / outbound parent calls) ───────────────────────────────
# POST https://api.vobiz.ai/api/v1/Account/{VOBIZ_AUTH_ID}/Call/
# Auth headers: X-Auth-ID / X-Auth-Token.
# NOTE: Vobiz authenticates with an auth-id + auth-token pair, not a single
# "API key" — hence these names rather than VOBIZ_API_KEY.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Verified caller ID on your Vobiz account, E.164 (e.g. +918012345678).
VOBIZ_CALLER_ID=
VOBIZ_API_BASE=https://api.vobiz.ai/api/v1

# Which telephony provider to use:
#   simulated — browser-based fake call, same Sarvam+Claude pipeline (default,
#               demo-safe, no phone needed)
#   vobiz     — place real PSTN calls
TELEPHONY_PROVIDER=simulated

# ── Public base URL ─────────────────────────────────────────────────────────
# Vobiz fetches answer_url and <Play> audio over the public internet, so this
# must be publicly reachable when TELEPHONY_PROVIDER=vobiz.
# Local dev: run `ngrok http 8787` and paste the https URL here.
PUBLIC_BASE_URL=http://localhost:8787

# ── Voice service ───────────────────────────────────────────────────────────
VOICE_SERVICE_PORT=8787
# Where the Next.js app reaches the voice service to place a call.
VOICE_SERVICE_URL=http://127.0.0.1:8787
