{
  "name": "@eduplus/voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "dev:emulator": "tsx watch --env-file-if-exists=../../.env.local --env-file=../../.env.emulator src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env.local src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eduplus/core": "*",
    "@anthropic-ai/sdk": "^0.133.0",
    "fastify": "^5.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
